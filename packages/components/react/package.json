{
  "name": "@yopem-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "yopem-ui",
    "react",
    "ui",
    "tailwindcss"
  ],
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "author": "Karyana Yandi <karyana@yandi.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yopem/ui",
    "directory": "packages/components/react"
  },
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "bun run build -- --watch",
    "format:write": "prettier --write \"**/*.{ts,tsx,mts,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,jsx,mjs,json,md}\"",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "^5.0.0",
    "@tanstack/react-form": "^1.12.1",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-table": "^8.21.3",
    "@yopem-ui/react-icons": "workspace:*",
    "@yopem-ui/utils": "workspace:*",
    "react": "catalog:react"
  },
  "devDependencies": {
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@yopem/eslint-config": "catalog:config",
    "@yopem/prettier-config": "catalog:config",
    "@yopem/typescript-config": "catalog:config",
    "eslint": "catalog:config",
    "prettier": "catalog:config",
    "typescript": "catalog:config"
  },
  "peerDependencies": {
    "@ark-ui/react": "^4.9.2 || ^5.0.0",
    "react": "catalog:react"
  },
  "prettier": "@yopem/prettier-config/react"
}
