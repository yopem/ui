{
  "name": "@yopem-ui/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "@registry/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun run docs:generate && bun src/build.ts",
    "docs:generate": "bun src/docs-extract.ts",
    "typecheck": "bun run docs:generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@stylexjs/stylex": "^0.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.8",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript-api": "npm:typescript@6.0.2"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
