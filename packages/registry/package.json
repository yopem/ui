{
  "name": "@yopem-ui/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "@registry/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun run docs:generate && bun src/build.ts",
    "docs:generate": "bun src/docs-extract.ts",
    "typecheck": "bun run docs:generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/types": "^8.0.6",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript-api": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peer",
    "react-dom": "catalog:peer"
  }
}
