{
  "name": "@yopem-ui/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "@registry/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun run docs:generate && bun src/build.ts",
    "docs:generate": "bun src/docs-extract.ts",
    "typecheck": "bun run docs:generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@stylexjs/stylex": "^0.19.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-api": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
