{
  "extends": "@yopem/typescript-config/react",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["bun", "node"],
    "paths": {
      "@registry/*": ["./src/*"],
      "@docs/*": ["../../apps/docs/src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
