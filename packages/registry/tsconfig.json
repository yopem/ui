{
  "extends": "@yopem/typescript-config/react",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "paths": {
      "@registry/*": ["./src/*"],
      "@workspace/*": ["../../*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
