{
  "name": "@yopem-ui/cli",
  "version": "0.3.0",
  "description": "CLI for installing Yopem UI source components and StyleX setup",
  "keywords": [
    "cli",
    "stylex",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "yopem-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js",
      "default": "./dist/install.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js",
      "default": "./dist/project.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts ./src/init.ts ./src/install.ts ./src/project.ts --target=node --outdir=dist --external=typescript-api --external=semver && tsc --project tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.3",
    "typescript-api": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/semver": "^7.7.1"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
