{
  "name": "@yopem-ui/oxlint-plugin",
  "version": "0.0.2",
  "description": "Oxlint rules for Yopem UI projects",
  "keywords": [
    "oxlint",
    "stylex",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git",
    "directory": "packages/oxlint-plugin"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --outdir=dist --packages=external",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@yopem/typescript-config": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:peer"
  }
}
