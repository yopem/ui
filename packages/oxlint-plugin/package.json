{
  "name": "@yopem-ui/oxlint-plugin",
  "version": "0.0.1",
  "description": "Oxlint rules for Yopem UI projects",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --outdir=dist --packages=external",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@yopem/typescript-config": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:peer"
  }
}
