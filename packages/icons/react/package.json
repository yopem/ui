{
  "name": "@yopem-ui/react-icons",
  "version": "0.0.8",
  "description": "",
  "keywords": [
    "yopem-ui",
    "react",
    "icon",
    "lucide",
    "ui",
    "tailwindcss"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "Karyana Yandi <karyana@yandi.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yopem/ui",
    "directory": "packages/icons/react"
  },
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "dev": "pnpm build -- --watch",
    "format:write": "prettier --write \"**/*.{ts,tsx,mts,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,jsx,mjs,json,md}\"",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "catalog:react",
    "lucide-react": "0.511.0"
  },
  "devDependencies": {
    "@types/react": "catalog:react",
    "@yopem/eslint-config": "catalog:config",
    "@yopem/prettier-config": "catalog:config",
    "@yopem/typescript-config": "catalog:config",
    "eslint": "catalog:config",
    "prettier": "catalog:config",
    "tsup": "catalog:config",
    "typescript": "catalog:config"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "lucide-react": "0.511.0"
  },
  "prettier": "@yopem/prettier-config/react",
  "tsup": {
    "clean": true,
    "target": "es2022",
    "format": [
      "cjs",
      "esm"
    ]
  }
}
