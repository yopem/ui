{
  "name": "yopem-ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "generate-routes": "bun run --cwd apps/docs generate-routes",
    "build": "bun run registry:build && bun run --cwd apps/docs build",
    "registry:build": "bun run --cwd packages/registry build",
    "start": "bun run --cwd apps/docs start",
    "preview": "bun run --cwd apps/docs preview",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run build && PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:a11y": "bun run build && FULL_A11Y=1 PLAYWRIGHT_PRODUCTION=1 playwright test --project=chromium --grep @full-a11y",
    "lint": "oxlint lint .",
    "fmt": "oxfmt fmt .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.5.1",
    "@yopem/typescript-config": "^0.2.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  }
}
