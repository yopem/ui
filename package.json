{
  "name": "yopem-ui",
  "private": true,
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "deploy": "bun run build && bun run --cwd apps/docs deploy",
    "generate-routes": "bun run --cwd apps/docs generate-routes",
    "build": "bun run --cwd packages/oxlint-plugin build && bun run registry:build && bun run --cwd apps/docs build",
    "registry:build": "bun run --cwd packages/registry build",
    "release": "bun scripts/release.ts",
    "version": "changeset version && bun install",
    "start": "bun run --cwd apps/docs start",
    "preview": "bun run --cwd apps/docs preview",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "lint": "oxlint lint .",
    "fmt": "oxfmt fmt .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@yopem/oxlint-config": "^0.2.0",
    "@yopem/typescript-config": "catalog:",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "catalog:",
    "pkg-pr-new": "^0.0.88",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@babel/core": "^8.0.6",
    "@daypicker/react": "^10.0.2",
    "@stylexjs/stylex": "^0.19.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yopem/typescript-config": "^0.2.3",
    "lucide-react": "^1.51.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.5"
  },
  "catalogs": {
    "peer": {
      "oxlint": "^1.86.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0"
    }
  }
}
