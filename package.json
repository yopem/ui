    "zod": "^4.6.7",
    "@lexical/link": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "katex": "^0.19.1",
    "@lexical/headless": "^0.52.0",
    "@lexical/mark": "^0.52.0",
    "prismjs": "^1.30.0",
    "yjs": "^13.6.33",
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7"
  },
  "catalogs": {
    "peer": {
      "oxlint": "^1.89.0",
