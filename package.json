{
  "name": "ui",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git"
  },
  "author": "Karyana Yandi <karyana@yandi.me>",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/components/*",
      "packages/icons/*",
      "packages/utils"
    ],
    "catalogs": {
      "config": {
        "@yopem/eslint-config": "^0.2.0",
        "@yopem/prettier-config": "^0.1.3",
        "@yopem/typescript-config": "^0.2.0",
        "eslint": "^9.21.0",
        "prettier": "^3.5.3",
        "tailwindcss": "^4.0.2",
        "tsup": "^8.4.0",
        "typescript": "^5.7.3"
      },
      "react": {
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4"
      }
    }
  },
  "scripts": {
    "build": "turbo run build --filter=!./apps/web/",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=./apps/web/",
    "clean": "git clean -xdf dist .cache .turbo .next *.log",
    "clean:all": "bun run clean && bun run clean:deps",
    "clean:deps": "git clean -xdf node_modules",
    "dev": "turbo dev",
    "format:check": "turbo format:check",
    "format:write": "turbo format:write",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "postinstall": "lefthook install",
    "prebuild": "bun install",
    "predev": "bun run build --filter=!./apps/web/",
    "release": "changeset publish",
    "release:dev": "changeset publish --tag dev",
    "typecheck": "turbo typecheck",
    "version": "changeset version",
    "version:dev": "changeset version --snapshot dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.5",
    "@changesets/get-release-plan": "4.0.13",
    "@changesets/types": "6.1.0",
    "@yopem/eslint-config": "catalog:config",
    "@yopem/prettier-config": "catalog:config",
    "lefthook": "1.12.2",
    "prettier": "catalog:config",
    "turbo": "2.5.4",
    "typescript": "catalog:config"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.2.18",
  "prettier": "@yopem/prettier-config/base"
}
