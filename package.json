{
  "name": "yopem-ui",
  "private": true,
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "deploy": "bun run build && bun run --cwd apps/docs deploy",
    "generate-routes": "bun run --cwd apps/docs generate-routes",
    "build": "bun run --cwd packages/oxlint-plugin build && bun run registry:build && bun run --cwd apps/docs build",
    "registry:build": "bun run --cwd packages/registry build",
    "release": "bun scripts/release.ts",
    "version": "changeset version && bun install",
    "start": "bun run --cwd apps/docs start",
    "preview": "bun run --cwd apps/docs preview",
    "typecheck": "bun run --filter '*' typecheck && tsc --project tests/tsconfig.json",
    "test": "bun run registry:build && bun run --cwd packages/oxlint-plugin build && bun test --preload ./tests/stylex-preload.ts --tsconfig-override ./tests/tsconfig.json ./tests/cli ./tests/oxlint-plugin ./tests/editor-auth ./tests/editor-selection ./tests/editor-tables ./tests/editor-document-stores ./tests/editor-styles ./tests/editor-code ./tests/editor-columns ./tests/editor-date ./tests/editor-media ./tests/editor-docs ./tests/docs-build ./tests/editor-typeahead ./tests/editor-document ./tests/editor-ai ./tests/editor-ai-menu ./tests/editor-assets/assets.spec.ts ./tests/editor-assets/deadlines.test.ts ./tests/editor-assets-deadlines/postgres-deadline.spec.ts ./tests/editor-collaboration ./tests/editor-footnotes ./tests/editor-toc ./tests/editor-block-selection ./tests/editor-review ./tests/editor-search ./tests/editor-csv ./tests/editor-editing-rules ./tests/editor-labels ./tests/editor-docx/docx.test.ts ./tests/editor-docx/namespace.test.ts ./tests/editor-docx/fidelity.test.ts ./tests/editor-docx/zip-safety.test.ts ./tests/editor-list-presentation/model.test.ts ./tests/editor-editable-card ./tests/editor-copilot ./tests/editor-block-menu ./tests/editor-diagram/model.test.ts ./tests/editor-diagram/render.test.ts ./tests/editor-diagram/store.test.ts ./tests/editor-diagram/html.test.ts ./tests/editor-diagram-renderers/resource-policy.test.ts ./tests/editor-word-clipboard/word-clipboard.test.ts ./tests/editor-word-clipboard/office-metadata.test.ts ./tests/editor-word-clipboard/stale-target.test.ts ./tests/editor-drawing/model.test.ts ./tests/editor-drawing/runtime.test.ts ./tests/editor-drawing/mount.test.ts ./tests/editor-document-export/policy.test.ts ./tests/editor-document-export/png.test.ts",
    "test:e2e": "bun run build && PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:editor-callout-clipboard": "bun tests/editor-callout-clipboard/run.mjs",
    "test:editor-checklist": "node tests/editor-checklist/run.mjs",
    "test:a11y": "bun run build && FULL_A11Y=1 PLAYWRIGHT_PRODUCTION=1 playwright test --project=chromium --grep @a11y",
    "lint": "oxlint lint .",
    "fmt": "oxfmt fmt .",
    "fmt:check": "oxfmt --check .",
    "test:postgres-native": "bun --tsconfig-override tests/tsconfig.json tests/editor-document-stores/postgres-native.integration.ts",
    "test:postgres-native:node": "bun build --target=node --format=esm --packages=external --tsconfig-override tests/tsconfig.json tests/editor-document-stores/postgres-native.integration.ts --outfile=./test-results/postgres-native.mjs && node ./test-results/postgres-native.mjs",
    "test:document:standalone": "bun test ./tests/editor-document-browser/standalone.test.ts ./tests/editor-document-browser/accessible-blocks.test.ts",
    "test:editor-document-clipboard": "bun tests/editor-document-clipboard/run.mjs",
    "test:editor-assets-browser": "bun test ./tests/editor-assets/browser-security.spec.ts ./tests/editor-assets/browser.spec.ts ./tests/editor-assets/general-browser.spec.ts",
    "test:editor-cursor-overlay": "bun --tsconfig-override ./tests/tsconfig.json ./tests/editor-cursor-overlay/cursor-overlay.native.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
