{
  "name": "yopem-ui",
  "private": true,
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "deploy": "bun run build && bun run --cwd apps/docs deploy",
    "generate-routes": "bun run --cwd apps/docs generate-routes",
    "build": "bun run --cwd packages/oxlint-plugin build && bun run registry:build && bun run --cwd apps/docs build",
    "registry:build": "bun run --cwd packages/registry build",
    "release": "bun scripts/release.ts",
    "version": "changeset version && bun install",
    "start": "bun run --cwd apps/docs start",
    "preview": "bun run --cwd apps/docs preview",
    "typecheck": "bun run --filter '*' typecheck && tsc --project tests/tsconfig.json",
    "test": "bun run registry:build && bun run --cwd packages/oxlint-plugin build && bun test ./tests/cli ./tests/oxlint-plugin ./tests/editor-auth ./tests/editor-selection ./tests/editor-tables ./tests/editor-document-stores ./tests/editor-styles ./tests/editor-code ./tests/docs-build",
    "test:e2e": "bun run build && PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:editor-callout-clipboard": "bun tests/editor-callout-clipboard/run.mjs",
    "test:a11y": "bun run build && FULL_A11Y=1 PLAYWRIGHT_PRODUCTION=1 playwright test --project=chromium --grep @a11y",
    "lint": "oxlint lint .",
    "fmt": "oxfmt fmt .",
    "fmt:check": "oxfmt --check .",
    "test:postgres-native": "bun --tsconfig-override tests/tsconfig.json tests/editor-document-stores/postgres-native.integration.ts",
    "test:postgres-native:node": "bun build --target=node --format=esm --packages=external --tsconfig-override tests/tsconfig.json tests/editor-document-stores/postgres-native.integration.ts --outfile=./test-results/postgres-native.mjs && node ./test-results/postgres-native.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "^0.5.11",
    "@lexical/clipboard": "catalog:",
    "@lexical/code": "catalog:",
    "@lexical/extension": "catalog:",
    "@lexical/history": "catalog:",
    "@lexical/html": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/table": "catalog:",
    "@playwright/test": "^1.63.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@yopem-ui/editor": "workspace:*",
    "@yopem-ui/oxlint-plugin": "workspace:*",
    "@yopem/oxlint-config": "^0.5.0",
    "@yopem/typescript-config": "catalog:",
    "better-auth": "^1.7.12",
    "jose": "catalog:",
    "lefthook": "^2.2.1",
    "lexical": "catalog:",
    "miniflare": "^5.20260930.0-alpha",
    "oxfmt": "^0.72.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2004",
    "pg": "^8.23.1",
    "pkg-pr-new": "^0.0.91",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "^4.0.0-rc.115"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@babel/core": "^8.0.7",
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.2",
    "@lexical/clipboard": "^0.52.0",
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@stylexjs/stylex": "^0.19.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yopem/typescript-config": "^0.2.4",
    "jose": "^6.2.13",
    "lexical": "^0.52.0",
    "lucide-react": "^1.55.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.5"
  },
  "catalogs": {
    "peer": {
      "oxlint": "^1.87.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0"
    }
  }
}
