{
  "extends": "@yopem/typescript-config/base",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "paths": {
      "@registry/*": ["../packages/registry/src/*"],
      "@editor/*": ["../packages/editor/src/*"],
      "@cli/*": ["../packages/cli/src/*"],
      "@workspace/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
