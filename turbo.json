{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "@yopem-ui/registry#build": {
      "outputs": [
        "dist/**",
        "src/docs.generated.json",
        "$TURBO_ROOT$/apps/docs/public/r/**",
        "$TURBO_ROOT$/apps/docs/public/schema/**"
      ]
    }
  }
}
