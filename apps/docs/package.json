{
  "name": "@yopem/docs",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "(test -f ../../packages/registry/src/docs.generated.json || bun run --cwd ../../packages/registry docs:generate) && vite dev --host 127.0.0.1 --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:test": "vite build --mode test --logLevel warn",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.15.8",
    "lucide-react": "^1.33.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.32",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "unplugin": "^2.3.11",
    "vite": "^8.2.2"
  }
}
