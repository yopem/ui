{
  "name": "@yopem-ui/docs",
  "private": true,
  "description": "Documentation for Yopem UI",
  "keywords": [
    "cli",
    "stylex",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --cwd ../../packages/registry build && vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build && bun static.ts",
    "build:test": "vite build --mode test --logLevel warn && bun static.ts",
    "deploy": "export CLOUDFLARE_ACCOUNT_ID=661bd2c4ba9614f17d1d852772da422a && alchemy deploy --stage prod --adopt && wrangler pages deploy .output/public --project-name ui --branch main",
    "start": "wrangler pages dev .output/public --port ${PORT:-3100}",
    "preview": "vite preview",
    "typecheck": "bun run generate-routes && tsc --noEmit",
    "test:e2e": "PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:a11y": "FULL_A11Y=1 PLAYWRIGHT_PRODUCTION=1 playwright test --project=chromium --grep @a11y"
  },
  "dependencies": {
    "@daypicker/react": "catalog:",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@remixicon/react": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-table": "^9.2.4",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.15.14",
    "lucide-react": "catalog:",
    "nitro": "3.0.260903-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satori": "^0.33.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "catalog:",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.38",
    "@types/mdx": "^2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@yopem-ui/registry": "workspace:*",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "oxc-transform-react": "^0.145.0",
    "vite": "^8.3.1",
    "wrangler": "4.145.0"
  }
}
