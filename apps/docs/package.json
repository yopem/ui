{
  "name": "@yopem-ui/docs",
  "private": true,
  "description": "Documentation for Yopem UI",
  "keywords": [
    "cli",
    "stylex",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/yopem/ui/issues"
  },
  "license": "MIT",
  "author": "Karyana Yandi <karyana@yandi.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yopem/ui.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --cwd ../../packages/registry build && vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build && bun static.ts",
    "build:test": "vite build --mode test --logLevel warn && bun static.ts",
    "deploy": "alchemy deploy --stage prod --adopt && wrangler pages deploy .output/public --project-name ui --branch main",
    "start": "wrangler pages dev .output/public --port ${PORT:-3100}",
    "preview": "vite preview",
    "typecheck": "bun run generate-routes && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/utils": "catalog:",
    "@daypicker/react": "catalog:",
    "@excalidraw/excalidraw": "catalog:",
    "@expo-google-fonts/inter": "^0.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lexical/html": "catalog:",
    "@mdx-js/rollup": "^3.1.1",
    "@remixicon/react": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@yopem-ui/editor": "workspace:*",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.17.8",
    "lexical": "catalog:",
    "lucide-react": "catalog:",
    "nitro": "^3.0.260903-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satori": "^0.63.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "^2.0.0-beta.84",
    "@babel/core": "catalog:",
    "@effect/platform-bun": "^4.0.6",
    "@effect/platform-node": "^4.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@types/mdx": "^2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@yopem-ui/registry": "workspace:*",
    "alchemy": "^2.0.0-beta.84",
    "effect": "^4.0.6",
    "oxc-transform-react": "^0.155.0",
    "remark-gfm": "^4.0.1",
    "vite": "catalog:",
    "wrangler": "^4.153.0"
  }
}
