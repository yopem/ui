{
  "name": "@yopem-ui/docs",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "(test -f ../../packages/registry/src/docs.generated.json || bun run --cwd ../../packages/registry docs:generate) && vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:test": "vite build --mode test --logLevel warn",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@remixicon/react": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-table": "^9.2.4",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.15.14",
    "lucide-react": "^1.48.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.33.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.38",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@yopem-ui/registry": "workspace:*",
    "vite": "^8.3.1"
  }
}
